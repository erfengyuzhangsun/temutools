# ==========================================
# Temu全托管运营平台 - 环境变量配置模板
# 部署前复制为 .env 并修改配置
# ==========================================

# --- 数据库模式 (mysql / sqlite) ---
DB_MODE=mysql

# --- MySQL 连接配置 (DB_MODE=mysql 时必填) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=temu
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=temu_tools

# --- SQLite 配置 (DB_MODE=sqlite 时有效) ---
# SQLITE_PATH=temu_tools.db

# --- 管理员密码 ---
# 用于登录管理后台 (http://your-ip:8501/?page=admin)
ADMIN_PASSWORD=你的管理后台密码

# --- 初始种子用户密码 ---
# 首次部署时系统自动创建的默认管理员密码
SEED_ADMIN_PASSWORD=admin@hjp1

# --- 加密密钥 (用于加密存储 Temu API Key/Secret) ---
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=你的加密密钥

# --- 应用端口 ---
PORT=8501
ADDRESS=0.0.0.0

# --- 代理配置 (可选，如果服务器需要代理访问 Temu API) ---
# HTTPS_PROXY=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
