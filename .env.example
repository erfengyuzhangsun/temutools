# ==========================================
# Temu全托管运营平台 - 环境变量配置模板
# 部署前复制为 .env 并修改配置
# 安全警告: .env 文件包含敏感信息，严禁提交到 Git！
# ==========================================

# --- 数据库模式 (mysql / sqlite) ---
# 生产环境必须使用 mysql
DB_MODE=mysql

# --- MySQL 连接配置 (DB_MODE=mysql 时必填) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=temu
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=temu_tools

# --- SQLite 配置 (DB_MODE=sqlite 时有效，仅用于本地开发) ---
# SQLITE_PATH=temu_tools.db

# --- 管理员密码 (必填) ---
# 用于登录管理后台，不设置则管理后台自动禁用
ADMIN_PASSWORD=你的管理后台密码

# --- 初始种子用户密码 (必填) ---
# 首次部署时自动创建默认管理员用户，不设置则跳过创建
SEED_ADMIN_PASSWORD=你的种子密码

# --- 加密密钥 (必填，用于加密 Temu API Key/Secret) ---
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=你的加密密钥

# --- 应用端口 ---
PORT=8501
ADDRESS=0.0.0.0

# --- 代理配置 (可选，如果服务器需要代理访问 Temu API) ---
# HTTPS_PROXY=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890

# ==========================================
# 云主机监控告警 - Webhook 通知配置
# 支持钉钉/企业微信/飞书/通用 Webhook
# ==========================================

# 钉钉机器人 Webhook (可选)
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# DINGTALK_WEBHOOK_SECRET=YOUR_SECRET

# 企业微信机器人 Webhook (可选)
# WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 飞书机器人 Webhook (可选)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK

# 通用 Webhook (可选，用于自定义接收端)
# GENERIC_WEBHOOK_URL=https://your-custom-webhook-url.com/alerts
