# ===== Server =====
SERVER_PORT=8080
SERVER_MODE=release
SERVER_ADDRESS=0.0.0.0

# ===== Database =====
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=temu
DB_PASSWORD=your_db_password_here
DB_NAME=temu_tools

# ===== Auth / JWT =====
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
TOKEN_EXPIRE=24
ADMIN_EMAIL=admin@jinpuhuang.com
ADMIN_PASSWORD=your_admin_password_here

# ===== Logging =====
LOG_FORMAT=json
LOG_LEVEL=info

# ===== Temu API (开发者凭证) =====
# 从 Temu Partner Platform 获取
TEMU_APP_KEY=your_app_key_here
TEMU_APP_SECRET=your_app_secret_here
TEMU_API_REGION=global
